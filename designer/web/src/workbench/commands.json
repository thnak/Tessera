{
  "version": 1,
  "commands": [
    {
      "id": "file.openFolder",
      "title": "Open Folder...",
      "category": "File",
      "description": "Open a project folder from this computer",
      "keybinding": {
        "default": "Mod+K Mod+O"
      },
      "enabled": "!project.busy && project.folderSupported",
      "services": [
        "project-io"
      ],
      "status": "live"
    },
    {
      "id": "file.openZip",
      "title": "Open Zip...",
      "category": "File",
      "description": "Open a project from a .zip file",
      "enabled": "!project.busy",
      "services": [
        "project-io"
      ],
      "status": "live"
    },
    {
      "id": "file.openRecent",
      "title": "Open Recent",
      "category": "File",
      "description": "Reopen a project opened before; the browser asks for folder access again",
      "enabled": "!project.busy && project.hasRecent && project.folderSupported",
      "args": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "x-provider": "recent"
          }
        },
        "required": [
          "index"
        ]
      },
      "services": [
        "project-io"
      ],
      "status": "live"
    },
    {
      "id": "file.samples",
      "title": "Open Sample",
      "category": "File",
      "description": "Show the sample gallery; picking one opens it as the project",
      "services": [
        "project-io"
      ],
      "status": "live"
    },
    {
      "id": "file.newFile",
      "title": "New File",
      "category": "File",
      "description": "Add a file to the project",
      "keybinding": {
        "default": "Ctrl+Alt+N"
      },
      "enabled": "!project.busy",
      "services": [
        "project-io"
      ],
      "note": "VS Code's Ctrl+N is reserved by the browser",
      "status": "live"
    },
    {
      "id": "file.save",
      "title": "Save",
      "category": "File",
      "titleShort": "Save",
      "description": "Write the changed files back to the opened folder",
      "keybinding": {
        "default": "Mod+S",
        "when": "!focus.palette"
      },
      "enabled": "project.source == 'folder' && !project.busy",
      "services": [
        "project-io"
      ],
      "status": "live"
    },
    {
      "id": "file.download",
      "title": "Download Project (.zip)",
      "category": "File",
      "description": "Download the project as a .zip",
      "keybinding": {
        "default": "Mod+Shift+S"
      },
      "enabled": "!project.busy",
      "services": [
        "project-io"
      ],
      "status": "live"
    },
    {
      "id": "file.renameFile",
      "title": "Rename File...",
      "category": "File",
      "description": "Rename the selected file",
      "keybinding": {
        "default": "F2",
        "when": "tree.focus"
      },
      "enabled": "!project.busy",
      "services": [
        "project-io"
      ],
      "status": "live"
    },
    {
      "id": "file.deleteFile",
      "title": "Delete File",
      "category": "File",
      "description": "Delete the selected file",
      "keybinding": {
        "default": "Delete",
        "when": "tree.focus"
      },
      "enabled": "!project.busy",
      "services": [
        "project-io"
      ],
      "status": "live"
    },
    {
      "id": "file.share",
      "title": "Copy Share Link",
      "category": "File",
      "description": "Copy a link that opens this source, viewport and theme",
      "services": [
        "share"
      ],
      "status": "live"
    },
    {
      "id": "file.closeProject",
      "title": "Close Folder",
      "category": "File",
      "note": "reserved: project close slice",
      "status": "reserved"
    },
    {
