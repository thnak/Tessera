    {
      "id": "run.restart",
      "title": "Restart App",
      "category": "Run",
      "titleShort": "Restart",
      "description": "Cold start: discard state and run from a launch",
      "keybinding": {
        "default": "Mod+Shift+F5"
      },
      "enabled": "run.enabled",
      "services": [
        "viewer"
      ],
      "status": "live"
    },
    {
      "id": "run.applyNow",
      "title": "Apply Now",
      "category": "Run",
      "description": "Apply the source now instead of waiting for the live-edit pause",
      "keybinding": {
        "default": "Mod+Enter",
        "when": "editor.focus"
      },
      "enabled": "run.enabled",
      "services": [
        "viewer"
      ],
      "status": "live"
    },
    {
      "id": "run.inputScript",
      "title": "Run Input Script",
      "category": "Run",
      "description": "Replay the Scene panel's input script",
      "enabled": "run.enabled",
      "services": [
        "viewer"
      ],
      "status": "live"
    },
    {
      "id": "run.togglePicker",
      "title": "Picker",
      "category": "Run",
      "description": "Pick an element on the canvas",
      "enabled": "canvas.available",
      "checked": "run.picker",
      "services": [
        "viewer"
      ],
      "status": "live"
    },
    {
      "id": "run.toggleInspector",
      "title": "Inspector",
      "category": "Run",
      "description": "Inspect the element under the pointer",
      "enabled": "canvas.available",
      "checked": "run.inspector",
      "services": [
        "viewer"
      ],
      "status": "live"
    },
    {
      "id": "run.component",
      "title": "Component",
      "category": "Run",
      "description": "Choose the component the preview shows",
      "visible": "project.multiComponent",
      "checked": "run.component == arg.name",
      "args": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "x-provider": "components"
          }
        },
        "required": [
          "name"
        ]
      },
      "services": [
        "viewer"
      ],
      "status": "live"
    },
    {
      "id": "run.replay",
      "title": "Replay Recorded Session...",
      "category": "Run",
      "note": "reserved: device-profile series (#448)",
      "status": "reserved"
    },
    {
      "id": "device.profile",
      "title": "Device Profile",
      "category": "Device",
      "description": "Apply a device profile: size, pixel ratio, skin and fold",
      "checked": "device.profile == arg.id",
      "args": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "x-provider": "profiles"
          }
        },
        "required": [
          "id"
        ]
      },
      "services": [
        "viewer"
      ],
      "status": "live"
    },
    {
      "id": "device.setSkin",
      "title": "Skin",
      "category": "Device",
      "description": "Choose the device frame",
      "checked": "device.skin == arg.value",
      "args": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "x-provider": "skins"
          }
        },
        "required": [
          "value"
        ]
      },
      "services": [
        "viewer"
      ],
      "status": "live"
    },
    {
      "id": "device.setViewport",
      "title": "Viewport",
      "category": "Device",
      "description": "Resize the preview to a preset",
      "checked": "device.viewport == arg.value",
      "args": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^[0-9]+x[0-9]+$",
            "x-provider": "viewports"
          }
        },
        "required": [
          "value"
        ]
      },
      "services": [
        "viewer"
      ],
      "status": "live"
    },
    {
      "id": "device.setCustomSize",
      "title": "Custom Size...",
      "category": "Device",
      "description": "Resize the preview to a typed width and height",
      "args": {
        "type": "object",
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 120,
            "maximum": 4096
          },
          "height": {
            "type": "integer",
            "minimum": 120,
            "maximum": 4096
          }
        },
        "required": [
          "width",
          "height"
        ]
      },
      "services": [
        "viewer"
      ],
      "status": "live"
    },
    {
      "id": "device.setDpr",
      "title": "Pixel Ratio",
      "category": "Device",
      "description": "Set the device pixel ratio",
      "checked": "device.dpr == arg.value",
      "args": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "x-provider": "dprs"
          }
        },
        "required": [
          "value"
        ]
      },
      "services": [
        "viewer"
      ],
      "status": "live"
    },
    {
      "id": "device.setFold",
      "title": "Fold Posture",
      "category": "Device",
