    {
      "id": "view.layoutPreset",
      "title": "Layout Preset",
      "category": "View",
      "args": {
        "type": "object",
        "properties": {
          "preset": {
            "type": "string",
            "enum": [
              "default",
              "editorOnly",
              "previewFocus",
              "sideBySide"
            ]
          }
        },
        "required": [
          "preset"
        ]
      },
      "note": "reserved: dock slices W4/W5",
      "status": "reserved"
    },
    {
      "id": "view.togglePanel",
      "title": "Toggle Panel Visibility",
