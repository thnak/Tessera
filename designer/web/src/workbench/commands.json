      "args": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "enum": [
              "none",
              "flat",
              "book",
              "tabletop"
            ]
          }
        },
        "required": [
          "value"
        ]
      },
      "services": [
        "viewer"
      ],
      "status": "live"
    },
