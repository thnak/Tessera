{
  "name": "tessera-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The hosted Tessera studio page: React 19 chrome over the static Wasm host page (ADR-054)",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:site": "vite build",
    "build:chrome": "vite build --config vite.ssr.config.ts",
    "build": "npm run typecheck && npm run build:site && npm run build:chrome",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
