<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: MIT

  The Android app shell for a Tessera app (issue #189, docs/design/mobile-integration.md section
  3.7). This is the minimum a native-only app needs: a NativeActivity that hands its ANativeWindow
  to the engine, and the declarations the platform reads before any code runs.

  What is deliberately NOT here yet, because the engine does not implement it:
    - android:localeConfig / android:networkSecurityConfig: the resources do not exist.
    - android:enableOnBackInvokedCallback: the engine has no back handler to invoke.
    - POST_NOTIFICATIONS: nothing posts a notification.
  Declaring a capability the app cannot honour is worse than omitting it: the platform will route
  events to a handler that does not exist. Each is added with the slice that implements it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The renderer needs Vulkan 1.3 (src/rendering/backend/vulkan/src/vulkan_device_selection.hpp
         rejects anything lower), so the app is not installable on a device that cannot run it. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="4198400"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:version="1"
        android:required="true" />

    <!-- Touch is the primary input on a phone but the engine also runs on a TV or a desktop-mode
         device, so it is not required. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:label="Tessera"
        android:supportsRtl="true">

        <!--
          The shell's own activity, not android.app.NativeActivity. The platform reports window
          insets, display cutouts and fold posture through Java APIs that have no NDK equivalent,
          so one Java class reads them and passes them across JNI (TesseraActivity/TesseraView).
          The activity owns no rendering: it creates the SurfaceView, which owns the surface and
          forwards input, and everything else stays in C++.

          configChanges is a contract: every change listed here is handled by the app instead of
          restarting it. The engine handles size/density/orientation through WindowMetrics, so the
          list matches what it actually consumes. A change NOT listed restarts the activity, which
          is the safe default (state restoration is not implemented yet).
        -->
        <activity
            android:name=".TesseraActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:label="Tessera"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
