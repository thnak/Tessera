{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "23",
        "TESSERA_STATIC_RUNTIME": "ON",
        "TESSERA_USE_COMPILER_CACHE": "ON"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Ninja Debug",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TESSERA_ENABLE_TRACING": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Ninja Release",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ci",
      "inherits": "release",
      "displayName": "CI Release",
      "cacheVariables": {
        "TESSERA_BUILD_TESTS": "ON",
        "TESSERA_ENABLE_TRACING": "ON"
      }
    },
    {
      "name": "vs2026",
      "inherits": "base",
      "displayName": "Visual Studio 2026",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "cacheVariables": {
        "TESSERA_ENABLE_TRACING": "ON"
      }
    },
    {
      "name": "vs2022",
      "inherits": "base",
      "displayName": "Visual Studio 2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "TESSERA_ENABLE_TRACING": "ON"
      }
    },
    {
      "name": "wasm-webgpu",
      "displayName": "Emscripten WebGPU (Wasm, needs EMSDK)",
      "description": "Builds the WebGPU device backend with the emdawnwebgpu port; emsdk version pinned in tools/emsdk-version.txt",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "23",
        "TESSERA_BUILD_TESTS": "OFF",
        "TESSERA_BUILD_POC": "OFF",
        "TESSERA_BUILD_VULKAN": "OFF",
        "TESSERA_ENABLE_TRACING": "OFF",
        "TESSERA_USE_COMPILER_CACHE": "OFF",
        "TESSERA_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026",
      "configuration": "Release"
    },
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022",
      "configuration": "Release"
    },
    {
      "name": "wasm-webgpu",
      "configurePreset": "wasm-webgpu",
      "targets": [
        "tessera_webgpu",
        "tessera_webgpu_mapping",
        "webgpu_wasm_smoke"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vs2022-release",
      "configurePreset": "vs2022",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
