#version 450
// Compute conformance probe (RHI 1.16, issue #683): out[i] = in[i] * mul + 1, for i < count. A test
// shader, not a production one, so it is compiled by the test's own rule and is not in the shader
// manifest.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Out { uint data[]; } out_buf;
layout(std430, binding = 1) readonly buffer In { uint data[]; } in_buf;
layout(push_constant) uniform Push {
    uint mul;
    uint count;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.count) {
        out_buf.data[i] = in_buf.data[i] * pc.mul + 1u;
    }
}
