#version 450
// GPU compute path rasterizer spike (ADR-071 evidence, issue #683). Fill only, scanline-binned.
//
// One source, three passes selected by a define:
//   PASS_CLEAR  work[0] = 0 (node counter), every row head = 0xFFFFFFFF.
//   PASS_BIN    one thread per segment: for each pixel row the segment crosses, push a node
//               {segment, next} onto that (path, row) list (atomic counter + atomic exchange).
//   PASS_FINE   one thread per pixel: for each path whose box holds the pixel, walk the (path, row)
//               list, sum the exact signed pixel area of every segment, apply the fill rule and
//               composite source-over into the straight-alpha RGBA8 output.
//
// The exact area of a segment inside one pixel row is the integral of (px + 1 - clamp(x(y), px, px+1))
// over the row slice; x(y) is linear, so splitting at the two pixel edges makes each piece exact at its
// midpoint. No sampling, no MSAA, no per-pixel memory beyond the output.

#ifdef PASS_FINE
layout(local_size_x = 16, local_size_y = 16) in;
#else
layout(local_size_x = 256) in;
#endif

layout(std430, binding = 0) readonly buffer Segs { uint segs[]; };   // 8 words: x0 y0 x1 y1 (f32), path, pad
layout(std430, binding = 1) readonly buffer Paths { uint paths[]; }; // 8 words: -, -, bx0 by0 bx1 by1, rule, rgba8
layout(std430, binding = 2) buffer Work { uint work[]; };            // counter, row heads, nodes
layout(std430, binding = 3) buffer Out { uint pixels[]; };           // straight RGBA8

layout(push_constant) uniform Push {
    uint width;
    uint height;
    uint path_count;
    uint seg_count;
    uint node_capacity;
    uint nodes_base;
    uint pad0;
    uint pad1;
} pc;

const uint kNil = 0xFFFFFFFFu;

#ifdef PASS_CLEAR
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint total = 1u + pc.path_count * pc.height;
    if (i == 0u) {
        work[0] = 0u;
    } else if (i < total) {
        work[i] = kNil;
    }
}
#endif

#ifdef PASS_BIN
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.seg_count) {
        return;
    }
    float y0 = uintBitsToFloat(segs[i * 8u + 1u]);
    float y1 = uintBitsToFloat(segs[i * 8u + 3u]);
    uint path = segs[i * 8u + 4u];
    if (y0 == y1) {
        return;
    }
    float ymin = min(y0, y1);
    float ymax = max(y0, y1);
    int row0 = max(int(floor(ymin)), 0);
    int row1 = min(int(ceil(ymax)) - 1, int(pc.height) - 1);
    for (int row = row0; row <= row1; ++row) {
        uint node = atomicAdd(work[0], 1u);
        if (node < pc.node_capacity) {
            uint head_index = 1u + path * pc.height + uint(row);
            uint previous = atomicExchange(work[head_index], node);
            work[pc.nodes_base + node * 2u] = i;
            work[pc.nodes_base + node * 2u + 1u] = previous;
        }
    }
}
#endif

#ifdef PASS_FINE
// Signed area of the pixel [px, px+1] x [py, py+1] lying to the right of segment (a, b).
float segment_area(vec2 a, vec2 b, float px, float py) {
    float sign_v = 1.0;
    if (a.y > b.y) {
        vec2 t = a;
        a = b;
        b = t;
        sign_v = -1.0;
    }
    float y0 = max(a.y, py);
    float y1 = min(b.y, py + 1.0);
    if (y1 <= y0) {
        return 0.0;
    }
    float inv_slope = (b.x - a.x) / (b.y - a.y);
    float xa = a.x + (y0 - a.y) * inv_slope;
    float xb = a.x + (y1 - a.y) * inv_slope;
    float dy = y1 - y0;
    if (max(xa, xb) <= px) {
        return sign_v * dy;
    }
    if (min(xa, xb) >= px + 1.0) {
        return 0.0;
    }
    float dx = xb - xa;
    float ts[4];
    int n = 0;
    ts[n++] = 0.0;
    if (dx != 0.0) {
        float tl = (px - xa) / dx;
        float tr = (px + 1.0 - xa) / dx;
        float lo = min(tl, tr);
        float hi = max(tl, tr);
        if (lo > 0.0 && lo < 1.0) {
            ts[n++] = lo;
        }
        if (hi > 0.0 && hi < 1.0) {
            ts[n++] = hi;
        }
    }
    ts[n++] = 1.0;
    float area = 0.0;
    for (int k = 0; k + 1 < n; ++k) {
        float xm = xa + dx * (ts[k] + ts[k + 1]) * 0.5;
        area += dy * (ts[k + 1] - ts[k]) * (px + 1.0 - clamp(xm, px, px + 1.0));
    }
    return sign_v * area;
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= pc.width || y >= pc.height) {
        return;
    }
    float px = float(x);
    float py = float(y);
    vec4 dst = vec4(0.0);
    for (uint p = 0u; p < pc.path_count; ++p) {
        uint base = p * 8u;
        if (int(x) < int(paths[base + 2u]) || int(x) >= int(paths[base + 4u]) ||
            int(y) < int(paths[base + 3u]) || int(y) >= int(paths[base + 5u])) {
            continue;
        }
        float w = 0.0;
        uint node = work[1u + p * pc.height + y];
        while (node != kNil) {
            uint s = work[pc.nodes_base + node * 2u];
            vec2 a = vec2(uintBitsToFloat(segs[s * 8u]), uintBitsToFloat(segs[s * 8u + 1u]));
            vec2 b = vec2(uintBitsToFloat(segs[s * 8u + 2u]), uintBitsToFloat(segs[s * 8u + 3u]));
            w += segment_area(a, b, px, py);
            node = work[pc.nodes_base + node * 2u + 1u];
        }
        float t = abs(w);
        float cov;
        if (paths[base + 6u] == 0u) {
            cov = min(t, 1.0);
        } else {
            float f = mod(t, 2.0);
            cov = f > 1.0 ? 2.0 - f : f;
        }
        if (cov <= 0.0) {
            continue;
        }
        uint packed = paths[base + 7u];
        vec4 c = vec4(float(packed & 255u), float((packed >> 8) & 255u),
                      float((packed >> 16) & 255u), float(packed >> 24)) / 255.0;
        vec4 src = vec4(c.rgb * c.a, c.a) * cov;
        dst = src + dst * (1.0 - src.a);
    }
    vec3 rgb = dst.a > 0.0 ? dst.rgb / dst.a : vec3(0.0);
    uvec4 q = uvec4(clamp(vec4(rgb, dst.a) * 255.0 + 0.5, 0.0, 255.0));
    pixels[y * pc.width + x] = q.r | (q.g << 8) | (q.b << 16) | (q.a << 24);
}
#endif
