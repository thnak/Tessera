# SPDX-License-Identifier: MIT
#
# CLI contract for `tessera theme` (issue #79): a generated token set is written, `--check` accepts
# it, a doctored copy is rejected with the TESSERA_THEME_CONTRAST diagnostic, a bad seed and a bad
# id prefix exit non-zero, and a rerun produces byte-identical output.
#
# Invoked by `theme_cli` in src/ui/style/CMakeLists.txt:
#   cmake -DTOOL=<tessera_theme> -DOUT=<build dir> -DGOLDEN=<tests/golden/theme> -P this file

if(NOT DEFINED TOOL OR NOT DEFINED OUT OR NOT DEFINED GOLDEN OR NOT DEFINED INSTRUMENT)
    message(FATAL_ERROR "theme_cli: TOOL, OUT, GOLDEN and INSTRUMENT are required")
endif()

file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")

set(generated "${OUT}/sunset.theme.json")
set(second "${OUT}/sunset-again.theme.json")

# 1. Generate a set for a saturated orange seed and write it.
execute_process(
    COMMAND "${TOOL}" theme --seed "#ff6a00" --out "${generated}" --quiet
    RESULT_VARIABLE result
    ERROR_VARIABLE error_text)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "theme_cli: `--seed` exited ${result}: ${error_text}")
endif()
if(NOT EXISTS "${generated}")
    message(FATAL_ERROR "theme_cli: `--seed` wrote no file")
endif()

# 2. The same seed writes byte-identical output (determinism).
execute_process(
    COMMAND "${TOOL}" theme --seed "#ff6a00" --out "${second}" --quiet
    RESULT_VARIABLE result
    ERROR_VARIABLE error_text)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "theme_cli: the second `--seed` exited ${result}: ${error_text}")
endif()
execute_process(
    COMMAND "${CMAKE_COMMAND}" -E compare_files "${generated}" "${second}"
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "theme_cli: the same seed produced different bytes")
endif()

# 3. The golden for that seed is the bytes the tool just wrote.
execute_process(
    COMMAND "${CMAKE_COMMAND}" -E compare_files "${generated}" "${GOLDEN}/orange.theme.json"
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "theme_cli: the orange golden differs from the generated bytes")
endif()

# 4. `--check` accepts the generated set.
execute_process(
    COMMAND "${TOOL}" theme --check "${generated}" --quiet
    RESULT_VARIABLE result
    ERROR_VARIABLE error_text)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "theme_cli: `--check` rejected its own output: ${error_text}")
endif()

# 5. `--check` rejects a copy whose on-surface ink was changed to a near-background grey.
file(READ "${generated}" text)
string(REPLACE "\"--surface\": \"#ffffff\"" "\"--surface\": \"#ffffff\"" text "${text}")
string(REPLACE "\"--on-surface\": \"#1f1917\"" "\"--on-surface\": \"#f4f4f4\"" text "${text}")
set(doctored "${OUT}/doctored.theme.json")
file(WRITE "${doctored}" "${text}")
execute_process(
    COMMAND "${TOOL}" theme --check "${doctored}" --quiet
    RESULT_VARIABLE result
    ERROR_VARIABLE error_text)
if(result EQUAL 0)
    message(FATAL_ERROR "theme_cli: `--check` accepted a token set below the AA floor")
endif()
if(NOT error_text MATCHES "TESSERA_THEME_CONTRAST")
    message(FATAL_ERROR "theme_cli: the diagnostic did not lead with TESSERA_THEME_CONTRAST: "
                        "${error_text}")
endif()

# 6. A seed that is not a color is a usage error, and a prefix that cannot form theme ids too.
execute_process(
    COMMAND "${TOOL}" theme --seed "not-a-color" --out "${OUT}/bad.json"
    RESULT_VARIABLE result
    ERROR_VARIABLE error_text)
if(result EQUAL 0)
    message(FATAL_ERROR "theme_cli: an invalid seed was accepted")
endif()
if(NOT error_text MATCHES "TESSERA_THEME_SEED")
    message(FATAL_ERROR "theme_cli: the seed diagnostic was ${error_text}")
endif()

execute_process(
    COMMAND "${TOOL}" theme --seed "#0b5cad" --prefix "Bad Prefix" --out "${OUT}/bad2.json"
    RESULT_VARIABLE result
    ERROR_VARIABLE error_text)
if(result EQUAL 0)
    message(FATAL_ERROR "theme_cli: an invalid id prefix was accepted")
endif()
if(NOT error_text MATCHES "TESSERA_THEME_ID_PREFIX")
    message(FATAL_ERROR "theme_cli: the prefix diagnostic was ${error_text}")
endif()

# 7. `--check` on the shipped Instrument asset: the hand-maintained set passes the same lint.
execute_process(
    COMMAND "${TOOL}" theme --check "${INSTRUMENT}"
    RESULT_VARIABLE result
    ERROR_VARIABLE error_text)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "theme_cli: the shipped Instrument theme fails the contrast lint: "
                        "${error_text}")
endif()

message(STATUS "theme_cli: ok")
