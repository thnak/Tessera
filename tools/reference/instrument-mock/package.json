{
  "name": "tessera-instrument-mock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Plain React + Vite reference mock of the Instrument design language; does not use Tessera",
  "scripts": {
    "tokens": "node scripts/gen-tokens.mjs",
    "check:tokens": "node scripts/gen-tokens.mjs --check",
    "check:contrast": "node scripts/check-contrast.mjs",
    "predev": "npm run tokens",
    "dev": "vite",
    "prebuild": "npm run check:tokens",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
