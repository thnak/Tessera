{
  "schemaVersion": 1,
  "hooks": [
    {
      "name": "useTheme",
      "params": [],
      "returns": { "ts": "string", "ir": "string" },
      "lowering": { "kind": "environment", "provider": "theme" }
    },
    {
      "name": "useThemeState",
      "params": [],
      "returns": { "ts": "[string, (id: string) => void]", "ir": "string" },
      "lowering": { "kind": "environment", "provider": "theme", "writable": true }
    },
    {
      "name": "useBreakpoint",
      "params": [],
      "returns": { "ts": "\"compact\" | \"medium\" | \"expanded\"", "ir": "string" },
      "lowering": { "kind": "environment", "provider": "breakpoint" }
    },
    {
      "name": "useFocusTrap",
      "params": [
        { "name": "target", "kind": "ref", "element": "any" },
        {
          "name": "options",
          "kind": "options",
          "ts": "FocusTrapOptions",
          "ir": "record",
          "fields": [
            { "name": "active", "ts": "boolean", "ir": "bool", "default": true },
            { "name": "restoreFocus", "ts": "boolean", "ir": "bool", "default": true }
          ]
        }
      ],
      "returns": {
        "fields": [{ "name": "active", "ts": "boolean", "ir": "bool", "default": true }]
      },
      "lowering": { "kind": "behavior", "behavior": "focus_trap", "exclusive": true }
    },
    {
      "name": "useListFocus",
      "params": [
        { "name": "target", "kind": "ref", "element": "any" },
        {
          "name": "options",
          "kind": "options",
          "ts": "ListFocusOptions",
          "ir": "record",
          "fields": [
            {
              "name": "orientation",
              "ts": "\"horizontal\" | \"vertical\" | \"both\"",
              "ir": "string",
              "default": "vertical"
            },
            { "name": "wrap", "ts": "boolean", "ir": "bool", "default": true },
            { "name": "typeahead", "ts": "boolean", "ir": "bool", "default": false }
          ]
        }
      ],
      "returns": {
        "fields": [{ "name": "activeIndex", "ts": "number", "ir": "number", "default": -1 }]
      },
      "lowering": { "kind": "behavior", "behavior": "roving_focus", "exclusive": true }
    },
    {
      "name": "usePressFeedback",
      "params": [
        { "name": "target", "kind": "ref", "ts": "Element", "ir": "ref" },
        {
          "name": "options",
          "kind": "options",
          "ts": "PressFeedbackOptions",
          "ir": "record",
          "fields": [
            { "name": "disabled", "ts": "boolean", "ir": "bool", "default": false }
          ]
        }
      ],
      "returns": {
        "fields": [
          { "name": "pressed", "ts": "boolean", "ir": "bool", "default": false },
          { "name": "hovered", "ts": "boolean", "ir": "bool", "default": false },
          { "name": "focused", "ts": "boolean", "ir": "bool", "default": false }
        ]
      },
      "lowering": { "kind": "behavior", "behavior": "press_feedback" }
    }
  ]
}
