#
# The `#line` map compile test (issue #78). Two targets over the SAME developer class
# (tests/fixtures/codegen-line-map/Two.hpp, which defines neither bind::first nor bind::second):
#
#   codegen_line_map_mapped    the generated base made with `--line-directives`
#   codegen_line_map_control   the same base made without it (default output)
#
# Both are negative-compile targets excluded from `all`; one script asserts the mapped build reports
# TSX locations. The control needs no assertion: it exists so `#line`_directives = off still fails
# the same way with generated-file locations, which is what makes the comparison meaningful (a
# project that fails for an unrelated reason proves nothing).
#
# The fixture's base is generated by the CLI at build time, on the host, so a cross-compiling build
# skips the whole test (same rule as the compiler demo and the codegen_base_* negatives).

set(_tessera_line_map_fixture_dir ${CMAKE_SOURCE_DIR}/tests/fixtures/codegen-line-map)
set(_tessera_line_map_dir ${CMAKE_CURRENT_BINARY_DIR}/codegen_line_map)

foreach (_variant IN ITEMS mapped control)
    if (_variant STREQUAL "mapped")
        set(_line_flag "--line-directives")
    else ()
        set(_line_flag "")
    endif ()
    set(_out ${_tessera_line_map_dir}/${_variant})
    add_custom_command(
        OUTPUT ${_out}/Two.g.hpp
        COMMAND ${CMAKE_COMMAND} -E make_directory ${_out}
        COMMAND $<TARGET_FILE:tessera_codegen_cli> --write ${_line_flag}
                --root ${_tessera_line_map_fixture_dir} --namespace two --out ${_out}
                ${_tessera_line_map_fixture_dir}/Two.tsx
        DEPENDS tessera_codegen_cli ${_tessera_line_map_fixture_dir}/Two.tsx
        COMMENT "Generating the #line-map fixture base (${_variant})"
        VERBATIM)
    add_library(codegen_line_map_${_variant} OBJECT EXCLUDE_FROM_ALL
        ${_tessera_line_map_fixture_dir}/instantiate.cpp
        ${_out}/Two.g.hpp)
    target_include_directories(codegen_line_map_${_variant} PRIVATE
        ${_out} ${_tessera_line_map_fixture_dir})
    target_link_libraries(codegen_line_map_${_variant} PRIVATE tessera_scene)
    target_compile_features(codegen_line_map_${_variant} PRIVATE cxx_std_23)
endforeach ()

# The positive half of the text contract: the directives, the restored numbering, the default-off
# guarantee (no directive and no marker in the default output).
add_executable(codegen_line_map_tests
    ${CMAKE_SOURCE_DIR}/tests/unit/codegen_line_map_tests.cpp)
target_link_libraries(codegen_line_map_tests PRIVATE tessera_codegen)
add_test(NAME codegen_line_map COMMAND codegen_line_map_tests)

# The negative half: a real compiler run whose diagnostics must name TSX lines. Serialised with the
# other negative compiles because it drives the same build directory (issue #353).
add_test(NAME codegen_line_map_compile
    COMMAND ${CMAKE_COMMAND}
            -DBUILD_DIR=${CMAKE_BINARY_DIR}
            -DCONFIG=$<CONFIG>
            -DTARGET=codegen_line_map_mapped
            -DTSX=${_tessera_line_map_fixture_dir}/Two.tsx
            -DSOURCE=Two.tsx
            -P ${CMAKE_CURRENT_SOURCE_DIR}/line_map_compile_check.cmake)
set_tests_properties(codegen_line_map_compile PROPERTIES
    RESOURCE_LOCK tessera_codegen_negative_build)
