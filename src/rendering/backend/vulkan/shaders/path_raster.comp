#version 450
// GPU compute path rasterizer (ADR-071, issue #683): fills and GPU-expanded strokes, scanline-binned.
// The CPU side is src/rendering/path/gpu_path_encoder.cpp, which defines every buffer layout below.
//
// One source, four passes selected by a define:
//   PASS_CLEAR  work[0] = 0 (node counter), every row head = 0xFFFFFFFF.
//   PASS_STROKE one thread per stroke segment (the flattened centerline): expands it on the GPU into
//               edges written after the fill segments - a quad for the body, a wedge for the round
//               join at its start, a half disc for a round cap. Every piece is wound the same way and
//               abuts its neighbours along shared radii, so signed areas cancel there exactly and the
//               union is the stroke; only the self-overlap inside a sharp turn is clamped.
//   PASS_BIN    one thread per segment: for each pixel row the segment crosses, push a node
//               {segment, next} onto that (path, row) list (atomic counter + atomic exchange).
//   PASS_FINE   one thread per pixel: for each path whose box holds the pixel, walk the (path, row)
//               list, sum the exact signed pixel area of every segment, apply the fill rule and
//               composite source-over into the straight-alpha RGBA8 output.
//
// The exact area of a segment inside one pixel row is the integral of (px + 1 - clamp(x(y), px, px+1))
// over the row slice; x(y) is linear, so splitting at the two pixel edges makes each piece exact at its
// midpoint. No sampling, no MSAA, no per-pixel memory beyond the output.

#ifdef PASS_FINE
layout(local_size_x = 16, local_size_y = 16) in;
#else
layout(local_size_x = 256) in;
#endif

layout(std430, binding = 0) readonly buffer Segs { uint segs[]; };   // 8 words: x0 y0 x1 y1 (f32), path, pad
layout(std430, binding = 1) readonly buffer Paths { uint paths[]; }; // 16 words: affine a b c d e f (f32), rule, rgba8, bx0 by0 bx1 by1 (device pixels), 4 spare
layout(std430, binding = 2) buffer Work { uint work[]; };            // counter, row heads, nodes
layout(std430, binding = 3) buffer Out { uint pixels[]; };           // straight RGBA8
#ifdef PASS_STROKE
// 16 words: x0 y0 x1 y1 (f32), path, half width (f32), flags, join (0 round, 1 bevel, 2 miter),
// previous vertex x y (f32), miter limit (f32), cap (0 round, 1 butt, 2 square), path length at x0 y0
// (f32), first edge slot, dash pieces, -
layout(std430, binding = 4) readonly buffer Strokes { uint strokes[]; };
// Per path, 12 words: dash entry count (0 = solid), offset (f32), period (f32), -, up to 8 lengths (f32)
layout(std430, binding = 5) readonly buffer Dashes { uint dashes[]; };
#endif

// One record per raster of the batch (20 words), written by the host (gpu_path_encoder.hpp,
// PathRasterJob). Words 0-11 are the sizes of that raster; 12-17 are where its data starts inside the
// shared buffers, so a batch of N icons is one dispatch of each pass with the job as the second (the
// fine pass: third) grid dimension, instead of 4 dispatches and 24 bindings per icon.
layout(std430, binding = 6) readonly buffer Jobs { uint jobs[]; };

layout(push_constant) uniform Push {
    uint job_base; // first record of the dispatch, for a batch split across dispatches
} pcb;

struct Job {
    uint width;
    uint height;
    uint path_count;
    uint seg_count;
    uint node_capacity;
    uint nodes_base;
    uint fill_count;   // segments in the segs buffer; ids past it live in work at exp_base
    uint exp_base;     // first word of the GPU-expanded stroke segments inside the job's work region
    uint stroke_count;
    uint arc_edges;    // J: arc edges per join wedge or cap (a full circle is 2 * J)
    uint out_stride;   // words between output rows: width, or the copy pitch / 4 for a texture handoff
    uint spare;
};

// The raster this invocation works on, and where its slices of the shared buffers start (in words).
Job pc;
uint SB;
uint PB;
uint WB;
uint OB;
uint KB;
uint DB;

// The job index is a workgroup id (the local size is 1 in that dimension), so every invocation of a
// group reads the same record and the loads below can stay uniform instead of per lane.
void load_job(uint index) {
    uint b = (pcb.job_base + index) * 20u;
    pc = Job(jobs[b], jobs[b + 1u], jobs[b + 2u], jobs[b + 3u], jobs[b + 4u], jobs[b + 5u],
             jobs[b + 6u], jobs[b + 7u], jobs[b + 8u], jobs[b + 9u], jobs[b + 10u], jobs[b + 11u]);
    SB = jobs[b + 12u];
    PB = jobs[b + 13u];
    WB = jobs[b + 14u];
    OB = jobs[b + 15u];
    KB = jobs[b + 16u];
    DB = jobs[b + 17u];
}

const uint kNil = 0xFFFFFFFFu;

#if defined(PASS_BIN) || defined(PASS_FINE)
// A path's transform: x' = a x + c y + e, y' = b x + d y + f. Strokes are expanded in the path's own
// space and transformed here, so an animated frame rewrites 6 words per path and nothing else.
struct Xf {
    vec4 abcd;
    vec2 ef;
};

Xf path_xf(uint path) {
    uint b = path * 16u;
    Xf m;
    m.abcd = vec4(uintBitsToFloat(paths[PB + b]), uintBitsToFloat(paths[PB + b + 1u]),
                  uintBitsToFloat(paths[PB + b + 2u]), uintBitsToFloat(paths[PB + b + 3u]));
    m.ef = vec2(uintBitsToFloat(paths[PB + b + 4u]), uintBitsToFloat(paths[PB + b + 5u]));
    return m;
}

vec2 xf_apply(Xf m, vec2 p) {
    return vec2(m.abcd.x * p.x + m.abcd.z * p.y + m.ef.x, m.abcd.y * p.x + m.abcd.w * p.y + m.ef.y);
}

// A segment id below fill_count is a fill edge from the CPU; the rest were expanded from strokes.
uint seg_word(uint s, uint k) {
    return s < pc.fill_count ? segs[SB + s * 8u + k] : work[WB + pc.exp_base + (s - pc.fill_count) * 8u + k];
}
#endif

#ifdef PASS_CLEAR
void main() {
    load_job(gl_WorkGroupID.y);
    uint i = gl_GlobalInvocationID.x;
    uint total = 1u + pc.path_count * pc.height;
    if (i == 0u) {
        work[WB + 0] = 0u;
    } else if (i < total) {
        work[WB + i] = kNil;
    }
}
#endif

#ifdef PASS_STROKE
void put_edge(uint slot, vec2 a, vec2 b, uint path) {
    uint o = pc.exp_base + slot * 8u;
    work[WB + o] = floatBitsToUint(a.x);
    work[WB + o + 1u] = floatBitsToUint(a.y);
    work[WB + o + 2u] = floatBitsToUint(b.x);
    work[WB + o + 3u] = floatBitsToUint(b.y);
    work[WB + o + 4u] = path;
}

// Apex p, first rim point p + a, then the rim arc turning counter-clockwise by sweep, then back to p.
// sweep <= 0 writes nothing (zero-length edges are skipped by the bin pass).
void put_wedge(uint slot, vec2 p, vec2 a, float sweep, uint path) {
    uint arc = pc.arc_edges;
    // The rim needs one edge per step of the full-circle tessellation (a half turn is `arc` edges),
    // so a join that barely turns writes one edge instead of the whole fan; the rest of the slots stay
    // zero-length and cost the bin pass a thread each, nothing else.
    uint used = sweep <= 0.0 ? 0u : clamp(uint(ceil(sweep / 3.14159265358979 * float(arc))), 1u, arc);
    if (used == 0u) {
        for (uint k = 0u; k < arc + 2u; ++k) {
            put_edge(slot + k, vec2(0.0), vec2(0.0), path);
        }
        return;
    }
    // Each rim point is rotated from `a` by its own angle rather than stepped, so no error accumulates.
    vec2 prev = a;
    put_edge(slot, p, p + a, path);
    for (uint k = 0u; k < used; ++k) {
        float angle = sweep * float(k + 1u) / float(used);
        float c = cos(angle);
        float s = sin(angle);
        vec2 next = vec2(c * a.x - s * a.y, s * a.x + c * a.y);
        put_edge(slot + 1u + k, p + prev, p + next, path);
        prev = next;
    }
    put_edge(slot + 1u + used, p + prev, p, path);
    for (uint k = used + 2u; k < arc + 2u; ++k) {
        put_edge(slot + k, vec2(0.0), vec2(0.0), path);
    }
}

// Zero-length edges: the bin pass skips them, so an unused slot costs one thread and nothing else.
void put_zero(uint slot, uint count, uint path) {
    for (uint k = 0u; k < count; ++k) {
        put_edge(slot + k, vec2(0.0), vec2(0.0), path);
    }
}

// A bevel (tip_valid false) or miter join: apex p, the two outer offsets a and b, the miter tip when
// valid. Wound like the wedges, so the edges p->a and b->p cancel against the neighbouring bodies.
void put_corner(uint slot, vec2 p, vec2 a, vec2 b, vec2 tip, bool tip_valid, uint path) {
    uint size = pc.arc_edges + 2u;
    put_edge(slot, p, p + a, path);
    if (tip_valid) {
        put_edge(slot + 1u, p + a, p + tip, path);
        put_edge(slot + 2u, p + tip, p + b, path);
        put_edge(slot + 3u, p + b, p, path);
        put_zero(slot + 4u, size - 4u, path);
    } else {
        put_edge(slot + 1u, p + a, p + b, path);
        put_edge(slot + 2u, p + b, p, path);
        put_zero(slot + 3u, size - 3u, path);
    }
}

// A square cap: the body's end edge reversed (so it cancels), then out by hw along `extend`.
// `side` is the offset to the first corner (p + side first), `extend` is the extension.
void put_square(uint slot, vec2 p, vec2 side, vec2 extend, uint path) {
    put_edge(slot, p + side, p - side, path);
    put_edge(slot + 1u, p - side, p - side + extend, path);
    put_edge(slot + 2u, p - side + extend, p + side + extend, path);
    put_edge(slot + 3u, p + side + extend, p + side, path);
    put_zero(slot + 4u, pc.arc_edges + 2u - 4u, path);
}

// One run of a stroke along a segment direction d1: the body from pa to pb, then the start (a join
// against the previous vertex, or a cap) and the end (a cap, when this run ends the stroke or a dash).
// Occupies 7 + 2 * (arc_edges + 2) edge slots from `slot`: 7 for the body, the rest for the wedges.
//
// On the inside of a turn this body and the previous one overlap. Summing their partial coverage at
// the overlap's edge would overcount, so the body is cut: it starts from the previous body's end edge
// (p -> p + n0 on the inside), runs along the previous body's inner side to the point I where the two
// inner offset lines meet, and continues along its own. The cut is only valid while I lies inside both
// bodies (t = hw tan(sweep / 2) no longer than either run, and `back_run` is how far the previous
// body really extends behind pa: its segment, or less when a dash began inside it); otherwise the body
// stays whole and the overlap is clamped as before.
void emit_piece(uint slot, vec2 pa, vec2 pb, vec2 d1, float hw, bool join_start, bool end_cap,
                vec2 prev_point, float back_run, uint join_kind, float miter_limit, uint cap_kind,
                uint path) {
    uint wedge = pc.arc_edges + 2u;
    vec2 n1 = vec2(-d1.y, d1.x) * hw;
    float sweep = 0.0;
    vec2 a = n1;
    vec2 b = n1;
    bool trimmed = false;
    if (join_start) {
        vec2 dv = pa - prev_point;
        float dl = length(dv);
        if (dl > 0.0) {
            vec2 d0 = dv / dl;
            float cr = d0.x * d1.y - d0.y * d1.x;
            sweep = atan(abs(cr), dot(d0, d1));
            vec2 n0 = vec2(-d0.y, d0.x) * hw;
            a = cr > 0.0 ? -n0 : n1;
            b = cr > 0.0 ? -n1 : n0;
            float t = hw * tan(sweep * 0.5);
            if (sweep >= 1e-4 && sweep < 3.0 && t <= min(dl, back_run) && t <= length(pb - pa)) {
                trimmed = true;
                vec2 inner = (n0 + n1) / (1.0 + cos(sweep));
                if (cr > 0.0) {
                    vec2 corner = pa + inner;
                    put_edge(slot, pa - n1, pb - n1, path);
                    put_edge(slot + 1u, pb - n1, pb + n1, path);
                    put_edge(slot + 2u, pb + n1, corner, path);
                    put_edge(slot + 3u, corner, pa + n0, path);
                    put_edge(slot + 4u, pa + n0, pa, path);
                    put_edge(slot + 5u, pa, pa - n1, path);
                } else {
                    vec2 corner = pa - inner;
                    put_edge(slot, pa + n1, pa, path);
                    put_edge(slot + 1u, pa, pa - n0, path);
                    put_edge(slot + 2u, pa - n0, corner, path);
                    put_edge(slot + 3u, corner, pb - n1, path);
                    put_edge(slot + 4u, pb - n1, pb + n1, path);
                    put_edge(slot + 5u, pb + n1, pa + n1, path);
                }
                put_zero(slot + 6u, 1u, path);
            }
        }
    }
    if (!trimmed) {
        // body: wound so successive edges turn the same way as the wedges below
        put_edge(slot, pa + n1, pa - n1, path);
        put_edge(slot + 1u, pa - n1, pb - n1, path);
        put_edge(slot + 2u, pb - n1, pb + n1, path);
        put_edge(slot + 3u, pb + n1, pa + n1, path);
        put_zero(slot + 4u, 3u, path);
    }
    uint start_slot = slot + 7u;
    if (join_start) {
        if (sweep < 1e-4) {
            put_zero(start_slot, wedge, path);
        } else if (join_kind == 0u) {
            put_wedge(start_slot, pa, a, sweep, path);
        } else {
            // 1 / cos(sweep / 2) is the miter length over the stroke width: past the limit (or a
            // reversal, where it is unbounded) the join falls back to a bevel, as SVG specifies.
            bool miter = join_kind == 2u && cos(sweep * 0.5) * miter_limit >= 1.0;
            vec2 tip = (a + b) / (1.0 + cos(sweep));
            put_corner(start_slot, pa, a, b, tip, miter, path);
        }
    } else if (cap_kind == 0u) {
        put_wedge(start_slot, pa, n1, 3.14159265358979, path);
    } else if (cap_kind == 2u) {
        put_square(start_slot, pa, -n1, -d1 * hw, path);
    } else {
        put_zero(start_slot, wedge, path);
    }
    uint end_slot = start_slot + wedge;
    if (!end_cap || cap_kind == 1u) {
        put_zero(end_slot, wedge, path);
    } else if (cap_kind == 0u) {
        put_wedge(end_slot, pb, -n1, 3.14159265358979, path);
    } else {
        put_square(end_slot, pb, n1, d1 * hw, path);
    }
}

void main() {
    load_job(gl_WorkGroupID.y);
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.stroke_count) {
        return;
    }
    uint r = i * 16u;
    vec2 p0 = vec2(uintBitsToFloat(strokes[KB + r]), uintBitsToFloat(strokes[KB + r + 1u]));
    vec2 p1 = vec2(uintBitsToFloat(strokes[KB + r + 2u]), uintBitsToFloat(strokes[KB + r + 3u]));
    uint path = strokes[KB + r + 4u];
    float hw = uintBitsToFloat(strokes[KB + r + 5u]);
    uint flags = strokes[KB + r + 6u]; // 1 end of an open contour, 2 has a previous vertex, 4 contour start, 8 contour end
    uint join_kind = strokes[KB + r + 7u]; // 0 round, 1 bevel, 2 miter
    vec2 prev_point = vec2(uintBitsToFloat(strokes[KB + r + 8u]), uintBitsToFloat(strokes[KB + r + 9u]));
    float miter_limit = uintBitsToFloat(strokes[KB + r + 10u]);
    uint cap_kind = strokes[KB + r + 11u]; // 0 round, 1 butt, 2 square
    float s0 = uintBitsToFloat(strokes[KB + r + 12u]); // path length up to p0
    uint slot = strokes[KB + r + 13u];                 // first edge slot of this record
    uint pieces = strokes[KB + r + 14u];               // dash pieces this record has room for (1 = solid)
    uint wedge = pc.arc_edges + 2u;
    uint stride = 7u + 2u * wedge;
    vec2 d = p1 - p0;
    float len = length(d);
    if (len <= 0.0) {
        put_zero(slot, stride * pieces, path);
        return;
    }
    vec2 d1 = d / len;
    uint db = path * 12u;
    uint dn = dashes[DB + db]; // dash entries (alternating on / off), 0 = solid
    if (dn == 0u) {
        emit_piece(slot, p0, p1, d1, hw, (flags & 2u) != 0u, (flags & 1u) != 0u, prev_point,
                   1e30, join_kind, miter_limit, cap_kind, path);
        return;
    }
    // Dashes: walk the pattern across [s0, s0 + len]. The pattern phase is (s + offset) mod period, so
    // an animated offset is one float per path; the CPU split every segment to at most one period, so
    // `pieces` (on-entries + 1) always covers what a segment can hold.
    float offset = uintBitsToFloat(dashes[DB + db + 1u]);
    float period = uintBitsToFloat(dashes[DB + db + 2u]);
    float s1 = s0 + len;
    float ph = mod(s0 + offset, period);
    uint k = 0u;
    float c0 = 0.0;
    for (; k < dn; ++k) {
        float v = uintBitsToFloat(dashes[DB + db + 4u + k]);
        if (ph < c0 + v) {
            break;
        }
        c0 += v;
    }
    if (k >= dn) {
        k = 0u;
        c0 = 0.0;
        ph = 0.0;
    }
    float q = s0;
    uint used = 0u;
    for (uint guard = 0u; guard < 96u && q < s1 - 1e-4 && used < pieces; ++guard) {
        float v = uintBitsToFloat(dashes[DB + db + 4u + k]);
        float rem = c0 + v - ph;
        float qe = min(q + rem, s1);
        if (rem > 1e-3 && (k & 1u) == 0u) {
            bool starts_here = ph - c0 < 1e-3;
            bool at_contour_start = (flags & 4u) != 0u && q <= s0;
            bool join_start = !starts_here && !at_contour_start && (flags & 2u) != 0u;
            // A dash that ends inside (or exactly at the end of) this segment is capped; one that runs
            // on into the next segment is left for that segment's record to join.
            bool end_cap = q + rem <= s1 + 1e-3 || ((flags & 8u) != 0u && qe >= s1 - 1e-3);
            emit_piece(slot + used * stride, p0 + d1 * (q - s0), p0 + d1 * (qe - s0), d1, hw,
                       join_start, end_cap, prev_point, ph - c0, join_kind, miter_limit, cap_kind,
                       path);
            ++used;
        }
        ph += qe - q;
        q = qe;
        if (ph >= c0 + v - 1e-3) {
            ph = c0 + v;
            c0 = ph;
            ++k;
            if (k >= dn) {
                k = 0u;
                c0 = 0.0;
                ph = 0.0;
            }
        }
    }
    put_zero(slot + used * stride, (pieces - used) * stride, path);
}
#endif

#ifdef PASS_BIN
void main() {
    load_job(gl_WorkGroupID.y);
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.seg_count) {
        return;
    }
    uint path = seg_word(i, 4u);
    Xf m = path_xf(path);
    float y0 = xf_apply(m, vec2(uintBitsToFloat(seg_word(i, 0u)), uintBitsToFloat(seg_word(i, 1u)))).y;
    float y1 = xf_apply(m, vec2(uintBitsToFloat(seg_word(i, 2u)), uintBitsToFloat(seg_word(i, 3u)))).y;
    if (y0 == y1) {
        return;
    }
    float ymin = min(y0, y1);
    float ymax = max(y0, y1);
    int row0 = max(int(floor(ymin)), 0);
    int row1 = min(int(ceil(ymax)) - 1, int(pc.height) - 1);
    for (int row = row0; row <= row1; ++row) {
        uint node = atomicAdd(work[WB + 0], 1u);
        if (node < pc.node_capacity) {
            uint head_index = 1u + path * pc.height + uint(row);
            uint previous = atomicExchange(work[WB + head_index], node);
            work[WB + pc.nodes_base + node * 2u] = i;
            work[WB + pc.nodes_base + node * 2u + 1u] = previous;
        }
    }
}
#endif

#ifdef PASS_FINE
// Signed area of the pixel [px, px+1] x [py, py+1] lying to the right of segment (a, b).
float segment_area(vec2 a, vec2 b, float px, float py) {
    float sign_v = 1.0;
    if (a.y > b.y) {
        vec2 t = a;
        a = b;
        b = t;
        sign_v = -1.0;
    }
    float y0 = max(a.y, py);
    float y1 = min(b.y, py + 1.0);
    if (y1 <= y0) {
        return 0.0;
    }
    // Entirely left or right of the pixel by the endpoints' x range, which bounds the clipped
    // piece: the same answers as the checks below, without the division.
    if (max(a.x, b.x) <= px) {
        return sign_v * (y1 - y0);
    }
    if (min(a.x, b.x) >= px + 1.0) {
        return 0.0;
    }
    float inv_slope = (b.x - a.x) / (b.y - a.y);
    float xa = a.x + (y0 - a.y) * inv_slope;
    float xb = a.x + (y1 - a.y) * inv_slope;
    float dy = y1 - y0;
    if (max(xa, xb) <= px) {
        return sign_v * dy;
    }
    if (min(xa, xb) >= px + 1.0) {
        return 0.0;
    }
    float dx = xb - xa;
    float ts[4];
    int n = 0;
    ts[n++] = 0.0;
    if (dx != 0.0) {
        float tl = (px - xa) / dx;
        float tr = (px + 1.0 - xa) / dx;
        float lo = min(tl, tr);
        float hi = max(tl, tr);
        if (lo > 0.0 && lo < 1.0) {
            ts[n++] = lo;
        }
        if (hi > 0.0 && hi < 1.0) {
            ts[n++] = hi;
        }
    }
    ts[n++] = 1.0;
    float area = 0.0;
    for (int k = 0; k + 1 < n; ++k) {
        float xm = xa + dx * (ts[k] + ts[k + 1]) * 0.5;
        area += dy * (ts[k + 1] - ts[k]) * (px + 1.0 - clamp(xm, px, px + 1.0));
    }
    return sign_v * area;
}

// The paths whose device box overlaps this 16 x 16 tile, as a bitmask over one chunk of 256 paths
// (one bit per invocation of the workgroup). A pixel then visits only those paths instead of every
// path of the raster, and walking the bits in ascending order keeps the compositing order exactly
// the path order, so the result does not depend on which thread set its bit first.
shared uint tile_mask[8];

void main() {
    load_job(gl_WorkGroupID.z);
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    // No early return: every invocation must reach the barriers.
    bool inside = x < pc.width && y < pc.height;
    int tx0 = int(gl_WorkGroupID.x * 16u);
    int ty0 = int(gl_WorkGroupID.y * 16u);
    uint lane = gl_LocalInvocationIndex;
    float px = float(x);
    float py = float(y);
    vec4 dst = vec4(0.0);
    for (uint chunk = 0u; chunk < pc.path_count; chunk += 256u) {
        if (lane < 8u) {
            tile_mask[lane] = 0u;
        }
        barrier();
        uint tp = chunk + lane;
        if (tp < pc.path_count) {
            uint tb = tp * 16u;
            if (int(paths[PB + tb + 8u]) < tx0 + 16 && int(paths[PB + tb + 10u]) > tx0 &&
                int(paths[PB + tb + 9u]) < ty0 + 16 && int(paths[PB + tb + 11u]) > ty0) {
                atomicOr(tile_mask[lane >> 5], 1u << (lane & 31u));
            }
        }
        barrier();
        for (uint word = 0u; word < 8u; ++word) {
            uint bits = tile_mask[word];
            while (bits != 0u) {
                uint p = chunk + word * 32u + uint(findLSB(bits));
                bits &= bits - 1u;
                if (!inside) {
                    continue;
                }
                uint base = p * 16u;
                if (int(x) < int(paths[PB + base + 8u]) || int(x) >= int(paths[PB + base + 10u]) ||
                    int(y) < int(paths[PB + base + 9u]) || int(y) >= int(paths[PB + base + 11u])) {
                    continue;
                }
                // No segment on this row: the path does not touch it, whatever its box says.
                uint node = work[WB + 1u + p * pc.height + y];
                if (node == kNil) {
                    continue;
                }
                Xf m = path_xf(p);
                float w = 0.0;
                while (node != kNil) {
                    uint s = work[WB + pc.nodes_base + node * 2u];
                    vec2 a = xf_apply(m, vec2(uintBitsToFloat(seg_word(s, 0u)),
                                              uintBitsToFloat(seg_word(s, 1u))));
                    vec2 b = xf_apply(m, vec2(uintBitsToFloat(seg_word(s, 2u)),
                                              uintBitsToFloat(seg_word(s, 3u))));
                    w += segment_area(a, b, px, py);
                    node = work[WB + pc.nodes_base + node * 2u + 1u];
                }
                float t = abs(w);
                float cov;
                if (paths[PB + base + 6u] == 0u) {
                    cov = min(t, 1.0);
                } else {
                    float f = mod(t, 2.0);
                    cov = f > 1.0 ? 2.0 - f : f;
                }
                if (cov <= 0.0) {
                    continue;
                }
                uint packed = paths[PB + base + 7u];
                vec4 c = vec4(float(packed & 255u), float((packed >> 8) & 255u),
                              float((packed >> 16) & 255u), float(packed >> 24)) / 255.0;
                vec4 src = vec4(c.rgb * c.a, c.a) * cov;
                dst = src + dst * (1.0 - src.a);
            }
        }
        barrier();
    }
    if (!inside) {
        return;
    }
    vec3 rgb = dst.a > 0.0 ? dst.rgb / dst.a : vec3(0.0);
    uvec4 q = uvec4(clamp(vec4(rgb, dst.a) * 255.0 + 0.5, 0.0, 255.0));
    pixels[OB + y * pc.out_stride + x] = q.r | (q.g << 8) | (q.b << 16) | (q.a << 24);
}
#endif
